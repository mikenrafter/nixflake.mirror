#!/bin/env fish
if test "$argv[1]" = "init"
	set value (tailscale status)
	if test "$value" = "unexpected state: NoState"
		notif-manage button 0 true
		exit 1
	else
		notif-manage button 0 false
		exit 0
	end
end
set list 'false' 'true'
set -x SHELL /bin/bash
pkexec vpn-toggle $USER
set code $status
# 1 or 2
notif-manage button 0 $list[$code]
echo $list[$code]
