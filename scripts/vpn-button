#!/usr/bin/env fish
if test "$argv[1]" = "init"
	if test 1 -lt (tailscale status | wc -l)
		notif-manage button 0 true
		exit 1
	else
		notif-manage button 0 false
		exit 0
	end
end
set list 'false' 'true'
set -x SHELL /bin/bash
vpn-toggle
set code $status
# 1 or 2
notif-manage button 0 $list[$code]
echo $list[$code]
